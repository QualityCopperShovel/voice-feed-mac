<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Standard identity and executable metadata for the assembled app bundle. -->
    <key>CFBundleExecutable</key>
    <string>VoiceFeedMac</string>
    <key>CFBundleIdentifier</key>
    <string>com.aisloppy.voice-feed</string>
    <key>CFBundleName</key>
    <string>Voice Feed</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.3.6</string>

    <!-- Run as a menu-bar utility without adding a persistent Dock icon. -->
    <key>LSUIElement</key>
    <true/>

    <!-- macOS displays this text before granting microphone permission. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Voice Feed records short speech windows and sends them to your private Voice Feed account for transcription.</string>
</dict>
</plist>
